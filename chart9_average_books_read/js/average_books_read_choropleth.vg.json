
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "A World of Reading",
    "subtitle": "Average books read per year, 2024"
  },
  "width": 850,
  "height": 500,
  "projection": {"type": "equalEarth"},
  "data": {
    "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/3_choropleth_map/js/ne_110m_admin_0_countries.topojson",
    "format": {
      "type": "topojson",
      "feature": "ne_110m_admin_0_countries"
    }
  },
  "transform": [
    {
      "calculate": "datum.properties.NAME === 'United States of America' ? 'United States' : datum.properties.NAME === 'United Kingdom' ? 'United Kingdom' : datum.properties.NAME === 'Russian Federation' ? 'Russia' : datum.properties.NAME === 'South Africa' ? 'South Africa' : datum.properties.NAME",
      "as": "country_lookup"
    },
    {
      "lookup": "country_lookup",
      "from": {
        "data": {
          "url": "../../data/average-books-read-per-year-by-country-2026.csv",
          "format": {"type": "csv"}
        },
        "key": "country",
        "fields": ["BooksReadAnnually_2024"]
      }
    },
    {
      "calculate": "toNumber(datum.BooksReadAnnually_2024)",
      "as": "books"
    },
    {
      "joinaggregate": [
        {"op": "min", "field": "books", "as": "min_books"},
        {"op": "max", "field": "books", "as": "max_books"}
      ]
    },
    {
      "calculate": "isValid(datum.books) && datum.max_books > datum.min_books ? (datum.books - datum.min_books) / (datum.max_books - datum.min_books) : null",
      "as": "books_normalised"
    }
  ],
  "mark": {
    "type": "geoshape",
    "stroke": "#fffefa",
    "strokeWidth": 0.7
  },
  "encoding": {
    "color": {
      "field": "books_normalised",
      "type": "quantitative",
      "title": "Normalised books read",
      "scale": {
        "scheme": "yellowgreenblue",
        "domain": [0, 1]
      },
      "legend": {
        "orient": "none",
        "direction": "horizontal",
        "legendX": 350,
        "legendY": 500,
        "titleAnchor": "middle",
        "titleAlign": "center",
        "offset": 10,
        "gradientLength": 300
      }
    },
    "tooltip": [
      {
        "field": "properties.NAME",
        "type": "nominal",
        "title": "Country"
      },
      {
        "field": "books",
        "type": "quantitative",
        "title": "Books read annually",
        "format": ".2f"
      },
      {
        "field": "books_normalised",
        "type": "quantitative",
        "title": "Normalised score",
        "format": ".3f"
      }
    ]
  },
  "config": {
    "view": {"stroke": null},
    "title": {
      "font": "Arial",
      "color": "#233b40",
      "fontSize": 20,
      "anchor": "start"
    }
  }
}
