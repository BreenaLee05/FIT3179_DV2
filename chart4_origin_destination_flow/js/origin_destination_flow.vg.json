
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "#F8F5EF",
  "title": {
    "text": "Where Are Authors' Books Published?",
    "subtitle": "Filter international publishing flows by origin and book count"
  },
  "width": 850,
  "height": 500,
  "projection": {"type": "equalEarth"},

  "params": [
    {
      "name": "originRegion",
      "value": "All origins",
      "bind": {
        "input": "select",
        "options": [
          "All origins",
          "Europe",
          "Outside Europe"
        ],
        "name": "Origin region: "
      }
    },
    {
      "name": "selectedOrigin",
      "value": "All countries",
      "bind": {
        "input": "select",
        "options": [
          "All countries",
          "Argentina",
          "Australia",
          "Austria",
          "Belgium",
          "Brazil",
          "Canada",
          "Chile",
          "China",
          "Denmark",
          "France",
          "Germany",
          "India",
          "Ireland",
          "Italy",
          "Japan",
          "Mexico",
          "Netherlands",
          "New Zealand",
          "Norway",
          "Portugal",
          "South Africa",
          "Spain",
          "Sweden",
          "Switzerland",
          "United Kingdom",
          "United States"
        ],
        "name": "Author nationality: "
      }
    },
    {
      "name": "minBooks",
      "value": 1,
      "bind": {
        "input": "range",
        "min": 1,
        "max": 50,
        "step": 1,
        "name": "Minimum books per flow: "
      }
    }
  ],

  "layer": [
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/world-atlas@2/countries-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#DCE5EA",
        "stroke": "#FFFFFF",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/BreenaLee05/FIT3179_DV2/refs/heads/main/data/nationality_publication_flows.csv",
        "format": {"type": "csv"}
      },
      "transform": [
        {
          "filter": "datum.origin != datum.destination && datum.books >= minBooks"
        },
        {
          "filter": "selectedOrigin == 'All countries' || datum.origin == selectedOrigin"
        },
        {
          "filter": "originRegion == 'All origins' || (originRegion == 'Europe' && indexof(['Austria','Belgium','Bulgaria','Cyprus','Czech Republic','Denmark','Finland','France','Germany','Greece','Hungary','Ireland','Italy','Netherlands','Norway','Poland','Portugal','Spain','Sweden','Switzerland','United Kingdom'], datum.origin) >= 0) || (originRegion == 'Outside Europe' && indexof(['Austria','Belgium','Bulgaria','Cyprus','Czech Republic','Denmark','Finland','France','Germany','Greece','Hungary','Ireland','Italy','Netherlands','Norway','Poland','Portugal','Spain','Sweden','Switzerland','United Kingdom'], datum.origin) < 0)"
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#D97757",
        "opacity": 0.65
      },
      "encoding": {
        "longitude": {
          "field": "origin_lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "origin_lat",
          "type": "quantitative"
        },
        "longitude2": {"field": "destination_lon"},
        "latitude2": {"field": "destination_lat"},
        "strokeWidth": {
          "field": "books",
          "type": "quantitative",
          "scale": {
            "type": "sqrt",
            "domain": [1, 113],
            "range": [0.5, 4]
          },
          "legend": {"title": "Number of books"}
        },
        "tooltip": [
          {
            "field": "origin",
            "type": "nominal",
            "title": "Author nationality"
          },
          {
            "field": "destination",
            "type": "nominal",
            "title": "Publisher country"
          },
          {
            "field": "books",
            "type": "quantitative",
            "title": "Number of books"
          }
        ]
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/BreenaLee05/FIT3179_DV2/refs/heads/main/data/nationality_publication_flows.csv",
        "format": {"type": "csv"}
      },
      "transform": [
        {
          "filter": "datum.origin != datum.destination && datum.books >= minBooks"
        },
        {
          "filter": "selectedOrigin == 'All countries' || datum.origin == selectedOrigin"
        },
        {
          "filter": "originRegion == 'All origins' || (originRegion == 'Europe' && indexof(['Austria','Belgium','Bulgaria','Cyprus','Czech Republic','Denmark','Finland','France','Germany','Greece','Hungary','Ireland','Italy','Netherlands','Norway','Poland','Portugal','Spain','Sweden','Switzerland','United Kingdom'], datum.origin) >= 0) || (originRegion == 'Outside Europe' && indexof(['Austria','Belgium','Bulgaria','Cyprus','Czech Republic','Denmark','Finland','France','Germany','Greece','Hungary','Ireland','Italy','Netherlands','Norway','Poland','Portugal','Spain','Sweden','Switzerland','United Kingdom'], datum.origin) < 0)"
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#D97757",
        "opacity": 0.65
      },
      "encoding": {
        "longitude": {"field": "origin_lon", "type": "quantitative"},
        "latitude": {"field": "origin_lat", "type": "quantitative"},
        "longitude2": {"field": "destination_lon"},
        "latitude2": {"field": "destination_lat"},
        "strokeWidth": {
          "field": "books",
          "type": "quantitative",
          "scale": {"type": "sqrt", "domain": [1, 113], "range": [0.5, 4]},
          "legend": {"title": "Number of books"}
        },
        "tooltip": [
          {"field": "origin", "title": "Origin: Author nationality"},
          {"field": "destination", "title": "Destination: Publisher country"},
          {"field": "books", "title": "Number of books"}
        ]
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/BreenaLee05/FIT3179_DV2/refs/heads/main/data/nationality_publication_flows.csv",
        "format": {"type": "csv"}
      },
      "transform": [
        {
          "filter": "datum.origin != datum.destination && datum.books >= minBooks"
        },
        {
          "filter": "selectedOrigin == 'All countries' || datum.origin == selectedOrigin"
        },
        {
          "filter": "originRegion == 'All origins' || (originRegion == 'Europe' && indexof(['Austria','Belgium','Bulgaria','Cyprus','Czech Republic','Denmark','Finland','France','Germany','Greece','Hungary','Ireland','Italy','Netherlands','Norway','Poland','Portugal','Spain','Sweden','Switzerland','United Kingdom'], datum.origin) >= 0) || (originRegion == 'Outside Europe' && indexof(['Austria','Belgium','Bulgaria','Cyprus','Czech Republic','Denmark','Finland','France','Germany','Greece','Hungary','Ireland','Italy','Netherlands','Norway','Poland','Portugal','Spain','Sweden','Switzerland','United Kingdom'], datum.origin) < 0)"
        },
        {
          "calculate": "'Author nationality (origin)'", "as": "pointType"
        }
      ],
      "mark": {
        "type": "point",
        "shape": "circle",
        "filled": true,
        "color": "#0F766E",
        "size": 90,
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {"field": "origin_lon", "type": "quantitative"},
        "latitude": {"field": "origin_lat", "type": "quantitative"},
        "tooltip": [
          {"field": "origin", "title": "ORIGIN"},
          {"field": "destination", "title": "Destination"},
          {"field": "books", "title": "Number of books"}
        ],
        "color": {
          "field": "pointType",
          "type": "nominal",
          "scale": {
            "domain": [
              "Author nationality (origin)",
              "Publisher country (destination)"
            ],
            "range": ["#0F766E", "#F59E0B"]
          },
          "legend": {
            "title": "Point represents"
          }
        }
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/BreenaLee05/FIT3179_DV2/refs/heads/main/data/nationality_publication_flows.csv",
        "format": {"type": "csv"}
      },
      "transform": [
        {
          "filter": "datum.origin != datum.destination && datum.books >= minBooks"
        },
        {
          "filter": "selectedOrigin == 'All countries' || datum.origin == selectedOrigin"
        },
        {
          "filter": "originRegion == 'All origins' || (originRegion == 'Europe' && indexof(['Austria','Belgium','Bulgaria','Cyprus','Czech Republic','Denmark','Finland','France','Germany','Greece','Hungary','Ireland','Italy','Netherlands','Norway','Poland','Portugal','Spain','Sweden','Switzerland','United Kingdom'], datum.origin) >= 0) || (originRegion == 'Outside Europe' && indexof(['Austria','Belgium','Bulgaria','Cyprus','Czech Republic','Denmark','Finland','France','Germany','Greece','Hungary','Ireland','Italy','Netherlands','Norway','Poland','Portugal','Spain','Sweden','Switzerland','United Kingdom'], datum.origin) < 0)"
        },
        {
          "calculate": "'Publisher country (destination)'", "as": "pointType"
        }
      ],
      "mark": {
        "type": "point",
        "shape": "circle",
        "filled": true,
        "color": "#F59E0B",
        "size": 130,
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {"field": "destination_lon", "type": "quantitative"},
        "latitude": {"field": "destination_lat", "type": "quantitative"},
        "tooltip": [
          {"field": "origin", "title": "Origin"},
          {"field": "destination", "title": "DESTINATION"},
          {"field": "books", "title": "Number of books"}
        ],
        "color": {
          "field": "pointType",
          "type": "nominal",
          "scale": {
            "domain": [
              "Author nationality (origin)",
              "Publisher country (destination)"
            ],
            "range": ["#0F766E", "#F59E0B"]
          },
          "legend": {
            "title": "Point represents"
          }
        }
      }
    }
  ],

  "config": {
    "view": {"stroke": null},
    "title": {
      "anchor": "start",
      "fontSize": 20,
      "subtitleFontSize": 12
    }
  }
}
