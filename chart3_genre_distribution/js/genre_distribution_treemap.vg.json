{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "width": 1000,
  "height": 500,
  "padding": 5,
  "data": [
    {
      "name": "raw",
      "url": "https://raw.githubusercontent.com/BreenaLee05/FIT3179_DV2/refs/heads/main/data/genre_treemap_summary.csv",
      "format": {
        "type": "csv",
        "parse": {"total_reviews": "number", "book_count": "number"},
        "delimiter": ","
      }
    },
    {
      "name": "tree_data",
      "source": "raw",
      "transform": [
        {
          "type": "window",
          "sort": {"field": "total_reviews", "order": "descending"},
          "ops": ["row_number"],
          "as": ["rank"]
        },
        {"type": "filter", "expr": "datum.rank <= 10"},
        {"type": "formula", "expr": "'All Books'", "as": "parent"}
      ]
    },
    {"name": "root_node", "values": [{"categories": "All Books"}]},
    {"name": "combined", "source": ["root_node", "tree_data"]},
    {
      "name": "tree",
      "source": "combined",
      "transform": [
        {"type": "stratify", "key": "categories", "parentKey": "parent"},
        {
          "type": "treemap",
          "field": "total_reviews",
          "sort": {"field": "value", "order": "descending"},
          "method": "squarify",
          "size": [{"signal": "width"}, {"signal": "height"}]
        }
      ]
    },
    {
      "name": "leaves",
      "source": "tree",
      "transform": [{"type": "filter", "expr": "datum.children == 0"}]
    }
  ],
  "scales": [
    {
      "name": "color",
      "type": "ordinal",
      "domain": {"data": "raw", "field": "categories"},
      "range": {"scheme": "category20"}
    }
  ],
  "marks": [
    {
      "type": "rect",
      "from": {"data": "leaves"},
      "encode": {
        "enter": {"stroke": {"value": "#ffffff"}, "strokeWidth": {"value": 2}},
        "update": {
          "x": {"field": "x0"},
          "y": {"field": "y0"},
          "x2": {"field": "x1"},
          "y2": {"field": "y1"},
          "fill": {"scale": "color", "field": "categories"},
          "tooltip": {
            "signal": "{'Genre': datum.categories, 'Total Reviews': format(datum.total_reviews, ','), 'Books': datum.book_count}"
          }
        }
      }
    },
    {
  "type": "text",
  "from": {"data": "leaves"},
  "encode": {
    "enter": {
      "font": {"value": "sans-serif"},
      "fontSize": {"value": 11},
      "fontWeight": {"value": "bold"},
      "fill": {"value": "#ffffff"},
      "align": {"value": "center"},
      "baseline": {"value": "middle"},
      "limit": {"value": 150},
      "ellipsis": {"value": "…"}
    },
    "update": {
      "x": {
        "signal": "(datum.x0 + datum.x1) / 2"
      },
      "y": {
        "signal": "(datum.y0 + datum.y1) / 2"
      },
      "text": {
        "signal": "datum.categories"
      },
      "fontSize": {
        "signal": "min(12, max(8, (datum.x1 - datum.x0) / 9))"
      }
    }
  }
}
  ]
}